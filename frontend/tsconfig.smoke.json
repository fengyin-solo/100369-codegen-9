{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "/tmp/smoke-out",
    "rootDir": ".",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": false,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/data/**/*.ts",
    "src/api/**/*.ts",
    "test/smoke.mts"
  ]
}